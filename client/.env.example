# CLUTCH Client Environment Configuration
# WebSockets backend endpoint (Render, Railway, Fly.io, Cloudflare Worker, or VPS)
# When deploying frontend on Cloudflare Pages, set this to your backend server URL.
# If left empty, it connects to same origin (or localhost:3001 in dev mode).
VITE_SERVER_URL=https://your-clutch-backend.onrender.com

# Optional alternative prefix supported out of the box
REACT_APP_SERVER_URL=https://your-clutch-backend.onrender.com
